# =====================================================================================
#  DEVELOPMENT-ONLY VALUES. Every password and key in this file is PUBLIC: it is
#  committed to git. Use them on your own machine and nowhere else. Never copy one into
#  a shared, staging or production environment.
# =====================================================================================
#
# `make up` copies this file to deploy/compose/.env (git-ignored) the first time.
# Edit .env, not this file, to change a value locally.
#
# Compose interpolates these into compose.yaml; the server gets them as the environment
# variables listed in docs/CONVENTIONS.md §4.

# --- PostgreSQL --------------------------------------------------------------------
# Superuser of the dev cluster. Only the postgres container uses it. Postgres is
# published on 127.0.0.1:5432 (make dev-db, IDE runs of the server, tests).
POSTGRES_PASSWORD=dev-only-postgres
# postgres/init.sql creates the two application roles with these passwords.
#   tinfirm_owner  owns the schema and runs Flyway (SPRING_FLYWAY_*)
#   tinfirm_app    runtime role, row-level security applies (SPRING_DATASOURCE_*)
TINFIRM_OWNER_PASSWORD=dev-only-owner
TINFIRM_APP_PASSWORD=dev-only-app

# --- Server ------------------------------------------------------------------------
# Host ports (loopback only). Change them if 8080 or 5432 is taken on your machine;
# TINFIRM_PUBLIC_URL must then use the same HTTP port.
TINFIRM_HTTP_HOST_PORT=8080
# Bind address of the HTTP port. Keep 127.0.0.1 on a laptop. On a server behind a reverse
# proxy or tunnel on another machine, use the interface address or 0.0.0.0.
TINFIRM_HTTP_BIND=127.0.0.1
# Server image and resources (single-host deployments on small machines).
# TINFIRM_SERVER_IMAGE=tinfirm-server:local
# The model port's image; deploy-host.sh and tinfirm-auto-deploy set it with the server's.
# TINFIRM_MODEL_API_IMAGE=tinfirm-model-api:local
# TINFIRM_SERVER_MEM_LIMIT=2g
# TINFIRM_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
TINFIRM_DB_HOST_PORT=5432
TINFIRM_PUBLIC_URL=http://localhost:8080

# Credential vault master key, `keyId:base64(32 random bytes)`. DEV KEY: anyone who
# reads this file can decrypt every secret it wraps. For any real deployment, generate
# a fresh key (`openssl rand -base64 32`) and keep it in a secret store. The server
# refuses to start with this published key unless TINFIRM_PUBLIC_URL is a localhost URL.
TINFIRM_VAULT_KEYS=dev1:XKf8Qpd7Z2EHDLUrwIU2NcPXEuW//bYcP+l0K6XoKk4=
TINFIRM_VAULT_ACTIVE_KEY=dev1

# First instance admin, created on the first start (empty user table only). The server
# refuses to start with this published password unless TINFIRM_PUBLIC_URL is a localhost URL.
TINFIRM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TINFIRM_BOOTSTRAP_ADMIN_PASSWORD=dev-only-admin-password

# The instance's company, key `main` (ADR-0075; TINFIRM_COMPANIES_MAIN_* in compose.yaml).
# It is created at the server's start when it does not exist yet; a company from before
# with exactly this name is adopted instead. Renaming it later in the app is kept.
TINFIRM_COMPANY_NAME="My Company"
# Becomes OWNER while the company has none. Empty: TINFIRM_BOOTSTRAP_ADMIN_EMAIL.
TINFIRM_COMPANY_OWNER=
# SCIM 2.0 provisioning of the company's members by its identity provider (ADR-0087), with an
# Enterprise licence: its OWNER then issues the token in Settings, Sign-in. The endpoint is
# ${TINFIRM_PUBLIC_URL}/scim/v2.
TINFIRM_COMPANY_SCIM_ENABLED=false

# Session idle timeout and absolute lifetime (ISO-8601 durations).
TINFIRM_SESSION_IDLE_TIMEOUT=PT8H
TINFIRM_SESSION_MAX_AGE=P7D

# Session bundles (ADR-0097, docs/operations/session-bundles.md), part of elastic runners (Pro):
# a turn resumes its session on any company runner host. none, filesystem (the session-bundles
# volume, one server) or s3 (a private bucket of its own, with a key for it alone).
# TINFIRM_SESSION_BUNDLES_STORE=s3
# TINFIRM_SESSION_BUNDLES_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
# TINFIRM_SESSION_BUNDLES_S3_BUCKET=tinfirm-session-bundles
# TINFIRM_SESSION_BUNDLES_S3_ACCESS_KEY_ID=
# TINFIRM_SESSION_BUNDLES_S3_SECRET_ACCESS_KEY=

# Error reports (ADR-0070, docs/operations/error-reports.md): the server's and the web app's
# errors, scrubbed, on the instance admins' page Errors. off, local or automatic; empty lets the
# admins choose there. Automatic delivery needs the vendor's DSN; nothing is sent without it.
# TINFIRM_ERROR_REPORTS=
# TINFIRM_ERROR_REPORTS_DSN=https://<key>@errors.example.com/<project id>
# TINFIRM_ERROR_REPORTS_LABEL=acme-prod
# TINFIRM_ERROR_REPORTS_PROXY=http://proxy.example.com:3128

# --- LiteLLM, the model gateway (docs/operations/litellm.md) -------------------------
# Master key of the admin API. DEV KEY: anyone who reads this file has full control of
# the gateway and its provider keys. LiteLLM expects the `sk-` prefix. For any real
# deployment: `echo "sk-$(openssl rand -hex 32)"`. The server gets it as
# TINFIRM_MODEL_GATEWAY_ADMIN_KEY, and refuses to start with this published value unless
# TINFIRM_PUBLIC_URL is a localhost URL.
LITELLM_MASTER_KEY=sk-dev-only-litellm-master-key
# Encrypts the provider keys LiteLLM stores in its database. DEV KEY, public like the one
# above. Generate a fresh one for any real deployment (`openssl rand -hex 32`), and NEVER
# change it once keys are stored: LiteLLM could no longer decrypt them.
LITELLM_SALT_KEY=dev-only-litellm-salt-key
# Password of the role `litellm`, owner of the database `litellm` (postgres/litellm.sql).
LITELLM_DB_PASSWORD=dev-only-litellm-db
# LiteLLM's port (admin API and model API) on 127.0.0.1, for the operator only. Never
# expose it: only the server reaches LiteLLM, and runner hosts reach only the server.
TINFIRM_LITELLM_HOST_PORT=4000
# TINFIRM_LITELLM_MEM_LIMIT=2g
# The model port (model-api, ADR-0069) on 127.0.0.1: LiteLLM's model routes alone, for a
# service run from the IDE with a LiteLLM key of its own. On the Compose network the
# company's services reach it as http://model-api:4001.
TINFIRM_MODEL_API_HOST_PORT=4001
# TINFIRM_MODEL_API_MEM_LIMIT=512m
# The model relay requires every runner host's own token with a run's model requests: runner
# host 0.3.0 is the minimum. Set false only while a host older than 0.3.0 is being upgraded.
# TINFIRM_MODEL_RELAY_REQUIRE_HOST_TOKEN=true

# --- Keycloak (profile oidc: make up-oidc) -------------------------------------------
# Admin console at http://keycloak.localhost:8180/admin, user `admin`.
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
# Secret of the confidential client `tinfirm` in keycloak/tinfirm-realm.json; the server
# presents the same value (compose.oidc.yaml).
TINFIRM_OIDC_CLIENT_SECRET=dev-only-oidc-client-secret
# Test user alice@example.com (verified email) in the tinfirm realm. A different email
# from the bootstrap admin on purpose: the server never links an OIDC login to an
# existing user by email, so alice becomes a new user on her first Keycloak login, and a
# Member of the company `main`, which her Keycloak group tinfirm-users gives (compose.oidc.yaml).
TINFIRM_OIDC_TEST_USER_PASSWORD=dev-only-alice

# --- Entra ID (compose.entra.yaml, docs/operations/entra-id.md) ------------------------
# No defaults: these come from your tenant's app registration. Set them in .env only,
# never in this file, and keep the client secret out of git.
# TINFIRM_ENTRA_TENANT_ID=
# TINFIRM_ENTRA_CLIENT_ID=
# TINFIRM_ENTRA_CLIENT_SECRET=
# Optional (ADR-0075): the email domains that get an account (comma-separated; empty: any
# email of the tenant).
# TINFIRM_ENTRA_EMAIL_DOMAINS=
# Recommended (ADR-0088): Entra ID decides each member's role at every sign-in, from the app
# roles of the app registration (docs/operations/entra-id.md). A person with none of them
# cannot sign in; their account and data are kept.
# TINFIRM_ENTRA_ROLE_CLAIM=roles
# TINFIRM_ENTRA_ROLE_MAP_ADMIN=Tinfirm.Admin
# TINFIRM_ENTRA_ROLE_MAP_MEMBER=Tinfirm.Member
# TINFIRM_ENTRA_ROLE_MAP_VIEWER=Tinfirm.Viewer
# Without the claim: the role of a new member (MEMBER, ADMIN or VIEWER), given once.
# TINFIRM_ENTRA_ROLE=MEMBER

# --- Internal hosts (ADR-0066) ---------------------------------------------------------
# Host names of company systems on this Compose network that the server may reach at a private
# address and over http, comma-separated: e.g. a company's own MCP server in a Compose
# stack of its own that joins this network.
# TINFIRM_CONNECTION_INTERNAL_HOSTS=mcp-tickets,mcp-wiki
