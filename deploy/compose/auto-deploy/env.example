# Settings of tinfirm-auto-deploy: ~/.config/tinfirm-auto-deploy/env of the deploy user.
# The script reads this file with bash. Every line here is a default; uncomment to change.
# docs/operations/auto-deploy.md explains them.

# stack: this host runs the Compose stack (and maybe a runner host). runner: this host runs
# only a runner host, and the server runs elsewhere (Kubernetes); the runner host follows the
# revision that server reports (docs/operations/auto-deploy.md, section 8).
#AUTO_DEPLOY_MODE=stack
# Runner mode: the server to follow. Empty = serverUrl of the runner host's config.json.
#AUTO_DEPLOY_SERVER_URL=
#AUTO_DEPLOY_RUNNER_CONFIG=$HOME/.config/tinfirm-runner/config.json

# What to follow: `rolling` (the prerelease of every push to main), a fixed release tag
# (v0.2.0), or `latest` (the newest versioned release).
#AUTO_DEPLOY_RELEASE=rolling
#AUTO_DEPLOY_REPO=FLOWTIVO/tinfirm
#AUTO_DEPLOY_TOKEN_FILE=$HOME/.config/tinfirm-auto-deploy/github-token
#AUTO_DEPLOY_SERVER_IMAGE=ghcr.io/flowtivo/tinfirm-server
#AUTO_DEPLOY_MODEL_API_IMAGE=ghcr.io/flowtivo/tinfirm-model-api

# The Compose install (deploy/compose/deploy-host.sh puts it here).
#AUTO_DEPLOY_COMPOSE_DIR=$HOME/tinfirm/deploy/compose
#AUTO_DEPLOY_PROJECT=tinfirm
#AUTO_DEPLOY_DATABASE=tinfirm
#AUTO_DEPLOY_READY_TIMEOUT=300

# pg_dump before every deploy; the newest N automatic dumps stay.
#AUTO_DEPLOY_BACKUP_DIR=$HOME/backups
#AUTO_DEPLOY_BACKUP_KEEP=10

# The runner host on this machine. No binary at this path: the runner step is skipped.
# A unit name change also needs install.sh --runner-unit <unit> run again: it installs
# tinfirm-auto-deploy-reload.service, which reloads exactly the unit it was installed for.
#AUTO_DEPLOY_RUNNER_BIN=$HOME/.local/bin/tinfirm-runner-host
#AUTO_DEPLOY_RUNNER_UNIT=tinfirm-runner

# Signed assets: the public key SHA256SUMS.sig must verify against. Empty =
# cosign-rolling.pub in this directory for rolling, cosign.pub for a versioned release
# (install.sh copies both).
#AUTO_DEPLOY_PUBLIC_KEY=
# 1 = deploy assets whose SHA256SUMS is not signed (a build of rolling made without the
# rolling key). A signature that does not verify is refused anyway. Keep it at 0 wherever
# rolling is signed.
#TINFIRM_AUTO_DEPLOY_ALLOW_UNSIGNED=0

# Attempts per revision before it gives up; revisions whose images and assets stay.
#AUTO_DEPLOY_MAX_ATTEMPTS=3
#AUTO_DEPLOY_KEEP_REVISIONS=3
