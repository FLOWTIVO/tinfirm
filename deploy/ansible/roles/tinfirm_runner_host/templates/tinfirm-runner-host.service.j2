{#- An argument for ExecStart: double quotes, with systemd's escapes for \, ", % and $. -#}
{%- macro arg(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"
{%- endmacro -%}
# {{ ansible_managed }}
# Tinfirm runner host (runner/README.md, deploy/ansible/README.md).
[Unit]
Description=Tinfirm runner host
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User={{ tinfirm_runner_host_user }}
Environment={{ arg('TINFIRM_RUNNER_CONFIG_DIR=' ~ tinfirm_runner_host_config_dir) }}
Environment={{ arg('TINFIRM_RUNNER_DATA_DIR=' ~ tinfirm_runner_host_data_dir) }}
Environment={{ arg('TINFIRM_RUNNER_LOG=' ~ tinfirm_runner_host_log) }}
{% if tinfirm_runner_host_bridge_binary | length > 0 %}
Environment={{ arg('TINFIRM_RUNNER_BRIDGE_BINARY=' ~ tinfirm_runner_host_bridge_binary) }}
{% endif %}
ExecStart={{ tinfirm_runner_host_binary_path }} run \
    --max-concurrent-runs {{ tinfirm_runner_host_max_concurrent_runs | int }} \
    --sandbox-runtime {{ arg(tinfirm_runner_host_kata_runtime_name) }}{% if tinfirm_runner_host_sandbox_docker | bool %} \
    --sandbox-docker{% endif %}{% if tinfirm_runner_host_egress_proxy | bool %} \
    --egress-proxy{% for host in _tinfirm_runner_host_egress_allow %} \
    --egress-allow {{ arg(host) }}{% endfor %}{% endif %}{% if tinfirm_runner_host_sandbox_bridge | bool %} \
    --sandbox-bridge{% endif %}{% for key, value in _tinfirm_runner_host_sandbox_env.items() %} \
    --sandbox-env {{ arg(key ~ '=' ~ value) }}{% endfor %}


# Drain: the active runs finish, then `run` exits 0 ...
ExecReload=/bin/kill -HUP $MAINPID
# ... and systemd starts it again, with the binary and the options that are installed now.
Restart=always
RestartSec=5
# SIGTERM cancels the runs and pushes their work in progress; give it time.
TimeoutStopSec=180

# Hardening (L27 of the security review of 2026-10-27; a company runner host is a tier-0
# asset beside the server). The host writes only its home, config and data directories; it
# reaches Docker through its socket, which a read-only file system does not stop.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ ([tinfirm_runner_host_home, tinfirm_runner_host_config_dir, tinfirm_runner_host_data_dir] | unique | map('string') | map('regex_replace', '%', '%%') | join(' ')) }}
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
