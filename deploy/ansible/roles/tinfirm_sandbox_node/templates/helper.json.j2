{#- The helper's configuration (runner/crates/tinfirm-node-agent/README.md, "The helper's").
    JSON has no comments, and the helper refuses an unknown field: the file is the one value
    below. Numbers are made numbers here, whatever the inventory's YAML gave. The role
    installs and loads the node's own firewall table, so the helper requires it
    (`nodeFirewall`): a node whose table is gone takes no new VM. With the AppArmor switch on,
    the role loads the VMMs' profile, so the helper requires it of every new VMM (`vmmProfile`);
    the profile names the chroot base and the work directory below, which stay the defaults.
    `hardening` gives the mark's lines what they need: the two ports that may listen beyond
    loopback, and the most days since the boot. -#}
{%- set templates = {} -%}
{%- for name, t in tinfirm_sandbox_node_templates.items() -%}
{%-   set _ = templates.update({name: {
        'vcpus': t.vcpus | int,
        'memoryMib': t.memoryMib | int,
        'snapshotMib': t.snapshotMib | int,
        'image': _tinfirm_sandbox_node_image,
        'kernel': _tinfirm_sandbox_node_kernel,
        'bridgePort': (t.bridgePort | default(7443)) | int,
        'pidsMax': (t.pidsMax | default(64)) | int,
      }}) -%}
{%- endfor -%}
{{ {
  'listenerUid': _tinfirm_sandbox_node_listener_uid | int,
  'socket': _tinfirm_sandbox_node_helper_socket,
  'spool': _tinfirm_sandbox_node_spool,
  'state': '/var/lib/tinfirm-node-agent/helper',
  'maxVms': tinfirm_sandbox_node_max_vms | int,
  'vmUidBase': tinfirm_sandbox_node_vm_uid_base | int,
  'nodeFirewall': 'required',
  'vmmProfile': 'required' if _tinfirm_sandbox_node_harden_on.mac | bool else 'not-required',
  'network': {
    'vmRange': tinfirm_sandbox_node_vm_range,
    'nodeAddress': tinfirm_sandbox_node_address,
    'controlHost': tinfirm_sandbox_node_control_host,
    'firstPort': tinfirm_sandbox_node_first_port | int,
  },
  'firecracker': {
    'jailer': _tinfirm_sandbox_node_jailer_path,
    'firecracker': _tinfirm_sandbox_node_firecracker_path,
    'chrootBase': '/srv/tinfirm-jails',
    'cgroupParent': tinfirm_sandbox_node_cgroup_parent,
    'work': '/var/lib/tinfirm-node-agent/work',
    'guestConsole': tinfirm_sandbox_node_guest_console | bool,
  },
  'hardening': {
    'agentPort': tinfirm_sandbox_node_agent_port | int,
    'sshPort': tinfirm_sandbox_node_ssh_port | int,
    'maxUptimeDays': tinfirm_sandbox_node_max_uptime_days | int,
  },
  'templates': templates,
} | to_nice_json(indent=2) }}
