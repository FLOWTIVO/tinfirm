                "connect": { "type": "string", "enum": ["private", "public"] },
                "templates": {
                  "description": "The driver's templates by name",
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["region", "size", "image", "vpc", "firewall"],
                    "properties": {
                      "region": { "type": "string", "minLength": 1 },
                      "size": { "type": "string", "minLength": 1 },
                      "image": { "description": "The VM image's snapshot id", "type": "string", "minLength": 1 },
                      "vpc": { "type": "string", "minLength": 1 },
                      "firewall": { "type": "string", "minLength": 1 },
                      "bridgePort": { "$ref": "#/definitions/port" }
                    }
                  }
                }
              }
            }
          }
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxReady": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "runtime": { "type": "string", "enum": ["claude", "codex", "pi", "opencode", "any"] },
            "headroom": { "type": "integer", "minimum": 0 },
            "maxAge": { "type": "integer", "minimum": 10, "maximum": 10080 },
            "coolDown": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "leadTimeMax": { "type": "integer", "minimum": 0, "maximum": 240 }
          }
        },
        "extraConfig": {
          "description": "More TINFIRM_RUNNER_* variables; never credentials",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "size": { "type": "string", "minLength": 1 },
            "storageClassName": { "type": "string" },
            "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "tmpVolume": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "sizeLimit": { "type": "string" } }
        },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
