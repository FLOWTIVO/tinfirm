# Build context of runner-musl.Dockerfile (the repository root): the Rust workspace, its paid
# code under ee/runner (ADR-0100) and the protocol schema it includes, and the licences the
# image carries, nothing else.
*
!runner
!ee/runner
!ee/LICENSE
!protocol
!LICENSE

runner/target

# Never, anywhere below the whitelisted directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/.idea
**/.vscode
