{
  "name": "tinfirm-web",
  "version": "1.0.0-rc.2-SNAPSHOT",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "generate:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "licences": "node scripts/licences.mjs",
    "e2e": "playwright test",
    "e2e:stack": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/harness/stack.ts",
    "e2e:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/harness/seed-cli.ts",
    "e2e:up": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/harness/stack.ts --seed",
    "screenshots": "playwright test -c scripts/screenshots.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.9.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "marked": "^18.1.3",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@spartan-ng/cli": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.4",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "ng-openapi-gen": "^1.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "smol-toml": "^1.9.0"
  }
}
