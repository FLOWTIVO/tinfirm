# The build context is the repository root, but the image build reads only these five
# directories and the root LICENSE. Whitelisting keeps the context small and keeps secrets
# (.env files, keys) and local build output out of it by construction.
*
!api
!web
!server
!libs
!ee
!LICENSE

# Minus local dependencies, build output and generated code; the Dockerfile rebuilds them.
web/node_modules
web/dist
web/.angular
web/coverage
web/playwright-report
web/test-results
web/src/app/api/generated
server/target

# Not read by `npm run build` or `mvnw -DskipTests package`.
web/e2e
server/src/test
libs/*/src/test
ee/src/test
ee/tools

# Never, anywhere below the whitelisted directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/.idea
**/*.iml
**/.vscode
