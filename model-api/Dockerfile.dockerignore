# Build context of model-api/Dockerfile (the repository root): the model port's own Maven project, the shared
# libraries it compiles in (libs/litellm, libs/net) and the root LICENSE, nothing else. The root .dockerignore serves
# the server's image.
*
!model-api
!libs/litellm
!libs/net
!LICENSE

model-api/target
model-api/src/test
libs/*/src/test

# Never, anywhere below the whitelisted path.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/.idea
**/*.iml
**/.vscode
