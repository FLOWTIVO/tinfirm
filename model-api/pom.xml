<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The same Spring Boot line as the server (CONVENTIONS §3). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.flowtivo.tinfirm</groupId>
  <artifactId>tinfirm-model-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Tinfirm model port</name>
  <description>The bundled LiteLLM's model API and nothing else, for the company's services: its model routes only,
    without LiteLLM's own request fields (ADR-0069)</description>

  <!-- The repository's root LICENSE (ADR-0077): MIT. The model port compiles in no ee/ code. -->
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>25</java.version>
    <!-- The dependency licence check and the third-party list (ADR-0082), as the server's. -->
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>tinfirm-model-api</finalName>
    <plugins>
      <plugin>
        <!-- The shared libraries (CONVENTIONS §2): their sources, tests and test resources are compiled into this
             build. libs/litellm, package com.flowtivo.tinfirm.shared.litellm; libs/net, package
             com.flowtivo.tinfirm.shared.net. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-libraries</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../libs/litellm/src/main/java</source>
                <source>${project.basedir}/../libs/net/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-library-tests</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../libs/litellm/src/test/java</source>
                <source>${project.basedir}/../libs/net/src/test/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-library-test-resources</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>add-test-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/../libs/litellm/src/test/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!--
          The licences of the dependencies this build ships (ADR-0082), as server/pom.xml checks the server's: the same
          merges and the same accepted licences, changed together with it, web/scripts/licences.mjs and
          runner/about.toml. The list of them, target/generated-sources/license/THIRD-PARTY.txt, goes into the image's
          /licenses/ (model-api/Dockerfile).
        -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>third-party</id>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <excludedScopes>test,provided,system</excludedScopes>
              <failOnMissing>true</failOnMissing>
              <failOnBlacklist>true</failOnBlacklist>
              <sortArtifactByName>true</sortArtifactByName>
              <licenseMerges>
                <licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
                <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0|The Apache License, Version 2.0|Apache License 2.0|Apache License Version 2.0|Apache License, version 2.0|Apache License</licenseMerge>
                <licenseMerge>BSD-3-Clause|BSD|BSD licence|The BSD License</licenseMerge>
                <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License v. 2.0|Eclipse Public License - v 2.0</licenseMerge>
                <licenseMerge>EDL-1.0|Eclipse Distribution License - v 1.0|Eclipse Distribution License v. 1.0|EDL 1.0</licenseMerge>
                <licenseMerge>GPL-2.0-only WITH Classpath-exception-2.0|GPL2 w/ CPE</licenseMerge>
                <licenseMerge>CC0-1.0|Public Domain, per Creative Commons CC0</licenseMerge>
              </licenseMerges>
              <includedLicenses>
                <includedLicense>MIT</includedLicense>
                <includedLicense>MIT-0</includedLicense>
                <includedLicense>Apache-2.0</includedLicense>
                <includedLicense>Apache-2.0 WITH LLVM-exception</includedLicense>
                <includedLicense>BSD-2-Clause</includedLicense>
                <includedLicense>BSD-3-Clause</includedLicense>
                <includedLicense>ISC</includedLicense>
                <includedLicense>0BSD</includedLicense>
                <includedLicense>Zlib</includedLicense>
                <includedLicense>Unlicense</includedLicense>
                <includedLicense>CC0-1.0</includedLicense>
                <includedLicense>Unicode-3.0</includedLicense>
                <includedLicense>Unicode-DFS-2016</includedLicense>
                <includedLicense>BSL-1.0</includedLicense>
                <includedLicense>EDL-1.0</includedLicense>
                <includedLicense>Bouncy Castle Licence</includedLicense>
                <includedLicense>OFL-1.1</includedLicense>
                <includedLicense>EPL-2.0</includedLicense>
                <includedLicense>MPL-2.0</includedLicense>
                <includedLicense>LGPL-2.1-only</includedLicense>
                <includedLicense>LGPL-2.1-or-later</includedLicense>
                <includedLicense>GPL-2.0-only WITH Classpath-exception-2.0</includedLicense>
              </includedLicenses>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
