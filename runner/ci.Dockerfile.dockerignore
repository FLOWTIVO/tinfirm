# Build context of ci.Dockerfile (the repository root): the Rust workspace, its paid code under
# ee/runner (ADR-0100), the protocol schemas it includes and the public suffix list its tests
# read, nothing else.
*
!runner
!ee/runner
!protocol
!server/src/main/resources/psl/public_suffix_list.dat

runner/target
runner/images/pi/node_modules

# Never, anywhere below the whitelisted paths.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/.idea
**/.vscode
