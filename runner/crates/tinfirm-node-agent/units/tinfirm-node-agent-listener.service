# The listener: an unprivileged user that takes the control host's TLS connection and asks
# the helper. It holds no capability and no device, and sees nothing of the machine but its
# own two directories, its configuration and the helper's socket.
[Unit]
Description=Tinfirm node agent: the listener (unprivileged), which takes the control host's connection
Requires=tinfirm-node-agent-helper.service
After=tinfirm-node-agent-helper.service network-online.target
Wants=network-online.target
# No start limit: under the default one (5 starts in 10 s), starts that fail in a row, or an
# installation's restarts on top of them, leave the unit failed for good, and the node takes
# no VM until someone starts its listener by hand.
StartLimitIntervalSec=0

[Service]
User=tinfirm-node-listener
Group=tinfirm-node-listener
ExecStart=/usr/local/bin/tinfirm-node-agent listener --config /etc/tinfirm/node-agent/listener.json
# The helper's socket is there a moment after the helper starts, and the listen address may
# come late at a boot: the listener waits for each, a minute at most, and then ends with an
# error. It is started again after that, and after any other failure. Five seconds later, not
# one: with no start limit, a fault that lasts (a key that cannot be read, a configuration
# that is refused) starts it again for good, and writes each start into the journal.
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Its network: the TLS port, and the helper's local socket. The node's role adds, in a
# drop-in, the one address that may connect:
#     [Service]
#     IPAddressAllow=<the control host's address>
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any

ProtectSystem=strict
ReadWritePaths=/var/lib/tinfirm-node-agent/spool /var/lib/tinfirm-node-agent/listener
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64

# Not here: `RuntimeDirectory=tinfirm-node-agent-listener` for the local socket of the single
# machine (planned). Under ProtectSystem=strict the listener cannot make that directory itself,
# and its group must be the runner host's, which only that installation knows.

[Install]
WantedBy=multi-user.target
